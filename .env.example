COOP_WALLET_ADDRESS=https://ilp.interledger-test.dev/argus-coop
BUYER_WALLET_ADDRESS=https://ilp.interledger-test.dev/da5d080e
KEY_ID=
PRIVATE_KEY_PATH=./private.key

# --- App foundation ---
# Long random string used to sign the session cookie (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
SESSION_SECRET=change-me-to-a-long-random-string
# SQLite file location
DB_PATH=./data/argus.db
# Demo order total in major USD units; must be a multiple of 10.00 (e.g. 100.00 or 10.00)
ORDER_TOTAL_MAJOR=100.00
# Demo login passwords (play money only)
DEMO_BUYER_PASSWORD=change-me
DEMO_OPERATOR_PASSWORD=change-me
DEMO_FARMER_A_PASSWORD=change-me
DEMO_FARMER_B_PASSWORD=change-me
DEMO_FARMER_C_PASSWORD=change-me
